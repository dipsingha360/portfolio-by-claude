# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Resend API key (https://resend.com/api-keys). Server-side only.
RESEND_API_KEY=

# The inbox that receives contact form messages.
# Until you verify a domain in Resend, this must be the email address you
# signed up to Resend with (the default sender can only deliver to it).
CONTACT_TO_EMAIL=

# Optional. The "from" address. Leave empty to use Portfolio <onboarding@resend.dev>.
# To send from your own domain, verify the domain in Resend first, then use e.g.
# CONTACT_FROM_EMAIL="Portfolio <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=

# --- Optional: keep a copy of every message in Supabase ---------------------
# Project URL and the PUBLISHABLE key (Supabase dashboard -> Project Settings -> API Keys).
# The publishable key can only add rows to the contact_messages table (row level
# security blocks reading), so it is safe, but keep it server-side anyway.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Optional: the public address of the site ---------------------------------
# Used for share-image, sitemap and canonical links. On Vercel it is detected
# automatically; set this once you have a custom domain, e.g. https://yourdomain.com
SITE_URL=
